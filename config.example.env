# Copy to config.env (git-ignored) and `set -a; . ./config.env; set +a` before running.
# Never commit real values.

# --- X (Twitter) posting, OAuth 1.0a user keys (x_post.py, x_source_reply.py)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional JSON file holding the same keys under {"card": {...}} as a fallback
PIPELINE_SECRETS_FILE=secrets.json

# --- Postiz (TikTok / YouTube Shorts scheduling, postiz_upload.sh)
POSTIZ_API_KEY=
POSTIZ_TIKTOK_ID=
POSTIZ_YOUTUBE_ID=

# --- Local LTX / ComfyUI host (local_gen)
LOCAL_GEN_SERVER=http://localhost:8188
COMFY_BIND=127.0.0.1
SPARK_SSH=user@spark-host
SPARK_SSH_KEY=~/.ssh/id_ed25519

# --- CLIs
GROK_BIN=grok
CLAUDE_BIN=claude
PY=python3            # venv with whisperx/demucs for alignment
DEMUCS=demucs

# --- QC knobs (defaults shown)
QC_STEP=0.25
QC_CUT_FPS=2
QC_GROK_MODEL=grok-4.7
GV_SHEET_MIN=7
GV_HERO_BUDGET=300
